package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	{{ byYear := sighting.CountByYear(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Sightings",
		Description: "Animal occurrence records from GBIF, lit up after dark.",
		Current:     "sightings",
	}) {
		<section class="hero">
			<div class="hero__glow"></div>
			<div class="hero__scene">
				@components.ThreeScene(components.ThreeSceneProps{
					Scene:    "globe",
					Backdrop: true,
				})
				@templ.JSONScript("globe-points", components.GlobePoints(sightings))
			</div>
			<div class="hero__inner">
				<p class="hero__eyebrow">GopherCon Africa · Nairobi</p>
				<h1>Wildlife, <em>after dark</em></h1>
				<p class="hero__lede">
					Occurrence records gathered from GBIF and paired with the weather at the hour they
					happened. Field notes from every continent, seen by naturalists since 1948.
				</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href="#sightings">Enter the field log</a>
					<a class="btn btn--ghost" href="#map">See the map</a>
				</div>
				if sum.Sightings > 0 {
					<ul class="hero__figures">
						<li><b>{ count(sum.Sightings) }</b><span>Sightings</span></li>
						<li><b>{ count(sum.Species) }</b><span>Species</span></li>
						<li><b>{ count(sum.Countries) }</b><span>Countries</span></li>
						<li><b>{ count(sum.Latest.Year() - sum.Earliest.Year()) }</b><span>Years</span></li>
					</ul>
				}
			</div>
		</section>
		if sum.Sightings > 0 {
			<section class="section container" id="stats">
				<div class="section__head reveal">
					<h2>Numbers</h2>
					<p>What the archive holds, counted from the records below.</p>
				</div>
				<hr class="rule reveal"/>
				<div class="stats reveal">
					<div class="stats__figures">
						<div class="stat">
							<b>{ count(sum.Sightings) }</b>
							<span>Sightings</span>
						</div>
						<div class="stat">
							<b>{ count(sum.Species) }</b>
							<span>Species</span>
						</div>
						<div class="stat">
							<b>{ count(sum.Countries) }</b>
							<span>Countries</span>
						</div>
						<div class="stat">
							<b>{ count(sum.Individuals) }</b>
							<span>Individuals</span>
						</div>
						<div class="stat">
							<b>{ count(sum.Media) }</b>
							<span>Photographs</span>
						</div>
						<div class="stat">
							<b>{ count(sum.Recorders) }</b>
							<span>Observers</span>
						</div>
					</div>
					<div class="stats__panel">
						<h3>Sightings per year</h3>
						@components.Sparkline(byYear, sum)
						<h3>Most-seen species</h3>
						@components.Bars(topSpecies(sightings, 5))
						<h3>Most-seen countries</h3>
						@components.Bars(topCountries(sightings, 5))
					</div>
				</div>
			</section>
		}
		if facts := fieldNotes(sightings); len(facts) > 0 {
			<section class="section container" id="notes">
				<div class="section__head reveal">
					<h2>Field notes</h2>
					<p>Extremes the records can prove: the coldest hour, the oldest note, the loneliest species.</p>
				</div>
				<hr class="rule reveal"/>
				<ul class="facts reveal">
					for _, f := range facts {
						<li class="fact">
							<span class="fact__label">{ f.Label }</span>
							<b class="fact__value">{ f.Value }</b>
							<span class="fact__detail">{ f.Detail }</span>
						</li>
					}
				</ul>
			</section>
		}
		<section class="section container" id="sightings">
			<div class="section__head reveal">
				<h2>Field log</h2>
				<p>The latest sightings, newest first. Every record keeps its observers and its photographs.</p>
			</div>
			<hr class="rule reveal"/>
			if len(sightings) == 0 {
				<p>No sightings have been ingested yet.</p>
			} else {
				@components.Filter(components.FilterProps{
					Target: "sightings-list",
					Search: true,
					Groups: []components.FilterGroup{
						{Key: "animal", Label: "Animal", Options: components.FilterOptions(sightings, 10, components.Animal)},
						{Key: "country", Label: "Country", Options: components.FilterOptions(sightings, 10, components.Country)},
						{Key: "decade", Label: "Decade", Options: components.FilterOptions(sightings, 8, components.Decade)},
					},
				})
				<ul class="wall" id="sightings-list">
					for _, s := range sightings {
						<li { components.FilterAttrs(s)... }>
							@components.SightingCard(s)
						</li>
					}
				</ul>
			}
		</section>
		<section class="section container" id="map">
			<div class="section__head reveal">
				<h2>Where they were</h2>
				<p>Every record with a position, grouped where they cluster. Each one jumps back to its tile.</p>
			</div>
			<hr class="rule reveal"/>
			<div class="map-wrap reveal">
				@components.Map(components.MapProps{
					Points:  components.MapPoints(sightings),
					Cluster: true,
					Class:   "map--dark",
					Label:   "Map of where the sightings were recorded",
				})
			</div>
		</section>
	}
}
