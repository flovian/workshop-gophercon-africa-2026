package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Sightings",
		Description: "Animal occurrence records from GBIF, lit up after dark.",
		Current:     "sightings",
	}) {
		<section class="hero">
			<div class="hero__glow"></div>
			<div class="hero__inner">
				<p class="hero__eyebrow">GopherCon Africa · Nairobi</p>
				<h1>Wildlife, <em>after dark</em></h1>
				<p class="hero__lede">
					Occurrence records gathered from GBIF and paired with the weather at the hour they
					happened. Field notes from every continent, seen by naturalists since 1948.
				</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href="#sightings">Enter the field log</a>
					<a class="btn btn--ghost" href="#map">See the map</a>
				</div>
				if sum.Sightings > 0 {
					<ul class="hero__figures">
						<li><b>{ count(sum.Sightings) }</b><span>Sightings</span></li>
						<li><b>{ count(sum.Species) }</b><span>Species</span></li>
						<li><b>{ count(sum.Countries) }</b><span>Countries</span></li>
						<li><b>{ count(sum.Latest.Year() - sum.Earliest.Year()) }</b><span>Years</span></li>
					</ul>
				}
			</div>
		</section>
		<section class="section container" id="sightings">
			<div class="section__head reveal">
				<h2>Field log</h2>
				<p>The latest sightings, newest first. Every record keeps its observers and its photographs.</p>
			</div>
			<hr class="rule reveal"/>
			if len(sightings) == 0 {
				<p>No sightings have been ingested yet.</p>
			} else {
				<ul class="wall" id="sightings-list">
					for _, s := range sightings {
						<li id={ "sighting-" + s.ID.String() }>
							@components.SightingCard(s)
						</li>
					}
				</ul>
			}
		</section>
	}
}
