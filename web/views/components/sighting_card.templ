package components

import (
	"cmp"
	"fmt"
	"math"
	"slices"
	"strings"

	"workshop/internal/domain/sighting"
	"workshop/internal/domain/species"
)

templ SightingCard(s sighting.Sighting) {
	<article class="card" id={ Anchor(s) }>
		<div class={ "card__media", templ.KV("card__media--empty", !hasCover(s.Media)) }>
			@Cover(s.Media)
			<span class="card__badge">{ place(s.Location) }</span>
		</div>
		if thumbs := strip(s.Media); len(thumbs) > 0 {
			<ul class="card__strip">
				for _, m := range thumbs {
					<li>
						<img src={ m.URL } alt={ altText(m) } loading="lazy" width="96" height="72"/>
					</li>
				}
			</ul>
		}
		<div class="card__body">
			<header class="card__header">
				<h2>{ displayName(s.Species) }</h2>
				if s.Species.ScientificName != "" {
					<p class="card__scientific">{ s.Species.ScientificName }</p>
				}
			</header>
			<dl class="card__meta">
				<dt>Seen</dt>
				<dd>{ s.HappenedAt.Format("2 January 2006") }</dd>
				<dt>Where</dt>
				<dd>{ place(s.Location) }</dd>
				if s.IndividualCount != nil {
					<dt>Count</dt>
					<dd>{ individuals(*s.IndividualCount) }</dd>
				}
				if s.RecordedBy != "" {
					<dt>Observed by</dt>
					<dd>{ s.RecordedBy }</dd>
				}
			</dl>
			<div class="card__weather">
				@Weather(s.Weather)
			</div>
			<footer class="card__source">
				<span class="card__coords" title="Recorded position, to three decimal places">
					{ coords(s.Location.Coordinates) }
				</span>
				if b := basis(s.BasisOfRecord); b != "" {
					<span class="card__basis">{ b }</span>
				}
				if s.ReferenceURL != "" {
					<a href={ templ.URL(s.ReferenceURL) } target="_blank" rel="noopener noreferrer">Source record</a>
				}
			</footer>
		</div>
	</article>
}

// Anchor is the element id a map popup jumps to.
func Anchor(s sighting.Sighting) string {
	return "sighting-" + s.ID.String()
}

// hasCover reports whether there is a photograph to lead with.
func hasCover(media []sighting.Media) bool {
	return len(imageOnly(media)) > 0
}

// Cover draws the lead photograph, or the empty state when GBIF sent none.
templ Cover(media []sighting.Media) {
	{{ images := imageOnly(media) }}
	if len(images) == 0 {
		<p class="card__cover-empty">No photograph on record</p>
	} else {
		<img src={ images[0].URL } alt={ altText(images[0]) } loading="lazy" width="800" height="600"/>
		if c := credit(images[0]); c != "" {
			<span class="card__credit">{ c }</span>
		}
	}
}

// altText is what the photograph shows, as GBIF recorded it.
func altText(m sighting.Media) string {
	return cmp.Or(m.Title, m.Description, "Sighting media")
}

// strip is the photographs after the lead one, at most three of them.
func strip(media []sighting.Media) []sighting.Media {
	images := imageOnly(media)
	if len(images) < 2 {
		return nil
	}
	return images[1:min(4, len(images))]
}

// imageOnly keeps the still photographs, since video and audio have no
// frame to show in a tile.
func imageOnly(media []sighting.Media) []sighting.Media {
	images := slices.DeleteFunc(slices.Clone(media), func(m sighting.Media) bool {
		return m.Type != "StillImage" || m.URL == ""
	})
	slices.SortFunc(images, func(a, b sighting.Media) int {
		return cmp.Or(
			b.Created.Compare(a.Created),
			cmp.Compare(a.URL, b.URL),
		)
	})
	return images
}

// displayName prefers the name a reader would recognise, falling back
// through the taxonomy as GBIF records thin out.
func displayName(sp species.Species) string {
	return cmp.Or(sp.VernacularName, sp.CanonicalName, sp.ScientificName, "Unknown species")
}

// place joins whichever parts of the location GBIF supplied.
func place(l sighting.Location) string {
	parts := slices.DeleteFunc(
		[]string{l.Locality, l.StateProvince, l.Country},
		func(s string) bool { return s == "" },
	)
	return cmp.Or(strings.Join(parts, ", "), "Location unknown")
}

// individuals renders how many animals were seen in a single sighting.
func individuals(n int) string {
	if n == 1 {
		return "1 individual"
	}
	return fmt.Sprintf("%d individuals", n)
}

// coords writes the recorded position the way a field note would: signed
// hemisphere rather than a minus sign, so it reads at a glance.
func coords(c sighting.Coordinates) string {
	ns, ew := "N", "E"
	if c.Latitude < 0 {
		ns = "S"
	}
	if c.Longitude < 0 {
		ew = "W"
	}
	return fmt.Sprintf("%.3f° %s, %.3f° %s", math.Abs(c.Latitude), ns, math.Abs(c.Longitude), ew)
}

// basis says in words how the record came to exist, which is the difference
// between a person who was there and a sensor someone left running.
func basis(b string) string {
	switch b {
	case "HUMAN_OBSERVATION":
		return "Seen by a person"
	case "MACHINE_OBSERVATION":
		return "Recorded by a sensor"
	case "PRESERVED_SPECIMEN":
		return "Preserved specimen"
	case "MATERIAL_SAMPLE":
		return "Material sample"
	case "OCCURRENCE":
		return "Occurrence"
	case "":
		return ""
	default:
		return strings.ToLower(strings.ReplaceAll(b, "_", " "))
	}
}

// credit names the photographer and, in short form, the licence GBIF carried,
// so every picture on the wall can be traced back to its owner.
func credit(m sighting.Media) string {
	return strings.Join(compact([]string{m.Creator, licence(m.License)}), " · ")
}

// licence shortens the common Creative Commons URLs; anything else is left
// as it came.
func licence(u string) string {
	switch {
	case u == "":
		return ""
	case strings.Contains(u, "publicdomain/zero"):
		return "CC0"
	case strings.Contains(u, "publicdomain/mark") || strings.Contains(u, "publicdomain"):
		return "Public domain"
	case strings.Contains(u, "licenses/by-nc-nd/"):
		return "CC BY-NC-ND"
	case strings.Contains(u, "licenses/by-nc-sa/"):
		return "CC BY-NC-SA"
	case strings.Contains(u, "licenses/by-nc/"):
		return "CC BY-NC"
	case strings.Contains(u, "licenses/by-nd/"):
		return "CC BY-ND"
	case strings.Contains(u, "licenses/by-sa/"):
		return "CC BY-SA"
	case strings.Contains(u, "licenses/by/"):
		return "CC BY"
	default:
		return u
	}
}

// compact drops the empty strings, so a join of the parts never leaves a
// dangling separator.
func compact(parts []string) []string {
	return slices.DeleteFunc(parts, func(s string) bool { return s == "" })
}
